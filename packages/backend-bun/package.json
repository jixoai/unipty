{
  "name": "@unipty/backend-bun",
  "version": "0.1.0",
  "description": "Official UniPty Backend adapting the runtime-native Bun.Terminal substrate for Bun >= 1.3.13 (Windows ConPTY since 1.3.14).",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "README-zh.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#package.json": "./package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./unipty.metadata": {
      "types": "./dist/unipty.metadata.d.ts",
      "import": "./dist/unipty.metadata.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "unipty": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@unipty/backend": "workspace:*"
  }
}
