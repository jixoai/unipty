{
  "name": "@unipty/backend-deno-sigma__pty-ffi",
  "version": "0.1.1",
  "description": "Official UniPty Backend adapting the third-party @sigma/pty-ffi (Rust portable-pty) substrate for Deno; self-contained npm package with vendored noinit closure and target dynamic libraries.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jixoai/unipty",
    "directory": "packages/backend-deno-sigma__pty-ffi"
  },
  "files": [
    "dist",
    "vendor",
    "README.md",
    "README-zh.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#package.json": "./package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./unipty.metadata": {
      "types": "./dist/unipty.metadata.d.ts",
      "import": "./dist/unipty.metadata.js"
    }
  },
  "scripts": {
    "build:vendor": "deno run -A scripts/vendor.sh.ts",
    "build": "deno run -A scripts/vendor.sh.ts --ensure && tsdown && deno run -A scripts/vendor.sh.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "deno test -A --no-check test/"
  },
  "dependencies": {
    "unipty": "workspace:*"
  },
  "devDependencies": {
    "@unipty/backend": "workspace:*"
  }
}
