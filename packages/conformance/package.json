{
  "name": "@unipty/conformance",
  "version": "0.1.1",
  "private": true,
  "description": "Private installed-public-package conformance harness, verification evidence writer, and release catalog aggregator for UniPty v1.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "conformance": "node runners/run-profile.ts",
    "evidence": "node runners/emit-evidence.ts",
    "catalog": "node runners/aggregate.ts"
  },
  "devDependencies": {
    "@unipty/backend": "workspace:*",
    "@unipty/backend-bun": "workspace:*",
    "@unipty/backend-deno-sigma__pty-ffi": "workspace:*",
    "@unipty/backend-node-pty": "workspace:*",
    "@unipty/helper-backend": "workspace:*",
    "unipty": "workspace:*"
  }
}
