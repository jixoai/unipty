{
  "name": "@unipty/conformance",
  "version": "0.1.0",
  "private": true,
  "description": "Private installed-public-package conformance harness, verification evidence writer, and release catalog aggregator for UniPty v1.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "conformance": "echo 'conformance runner pending (task 4.x)' && exit 1",
    "evidence": "echo 'evidence writer pending (task 7.1)' && exit 1",
    "catalog": "echo 'catalog aggregator pending (task 7.2)' && exit 1"
  },
  "devDependencies": {
    "@unipty/backend": "workspace:*",
    "@unipty/backend-bun": "workspace:*",
    "@unipty/backend-deno-sigma__pty-ffi": "workspace:*",
    "@unipty/backend-node-pty": "workspace:*",
    "@unipty/helper-backend": "workspace:*",
    "unipty": "workspace:*"
  }
}
