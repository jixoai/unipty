{
  "name": "@unipty/helper-backend",
  "version": "0.1.0",
  "description": "Build/development helper that generates explicit UniPty Backend manifest modules from ordered candidate inputs; not a runtime dependency.",
  "license": "MIT",
  "bin": {
    "unipty-helper-backend": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@unipty/backend": "workspace:*",
    "unipty": "workspace:*"
  }
}
